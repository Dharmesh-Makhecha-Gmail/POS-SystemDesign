    <mxCell id="BL2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="748" width="1310" height="100" as="geometry" />
    </mxCell>
    <mxCell id="BL2_h" value="Cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="748" width="150" height="100" as="geometry" />
    </mxCell>
    <mxCell id="Bs20" value="Σ = 5&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#444444&quot;&gt;store A · item X&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="210" y="763" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="Bs22" value="RECEIPT +10&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#444444&quot;&gt;Σ = 15&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="670" y="763" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="Bs23" value="append −3&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#444444&quot;&gt;Σ = 12&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
