    </mxCell>
    <mxCell id="Bu2" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#3B6FD6;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Bs14" target="Bs24">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="Bres" value="Result: Σ = 8 in any arrival order&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;Rows are only ever &lt;b&gt;inserted&lt;/b&gt;, never updated, so no write can overwrite another.&lt;br&gt;&lt;br&gt;Addition is order-independent: −3, −4, +10 in any order still gives &lt;b&gt;8&lt;/b&gt;.&lt;br&gt;&lt;br&gt;A repeated push hits the inbox key (deviceId, seq) and is applied once (see off-6).&lt;br&gt;&lt;br&gt;Every movement keeps its reason: SALE, RETURN, RECEIPT, TRANSFER, COUNT, WRITE-OFF.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1370" y="520" width="510" height="320" as="geometry" />
    </mxCell>
    <mxCell id="Bres_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1378" y="528" width="22" height="22" as="geometry" />
    </mxCell>

