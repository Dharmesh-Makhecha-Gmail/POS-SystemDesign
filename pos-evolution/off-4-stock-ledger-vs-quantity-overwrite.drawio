    <mxCell id="bC_t" value="C · Same example without the receipt: the ledger goes negative, and that is allowed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#D9822B;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
