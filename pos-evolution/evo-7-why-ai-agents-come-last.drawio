    <mxCell id="e2" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st1" target="st2">
