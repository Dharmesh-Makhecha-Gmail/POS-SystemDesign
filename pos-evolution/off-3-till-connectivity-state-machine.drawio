      <mxGeometry x="127" y="254.0" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="DG" value="DEGRADED&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;slow or partial: keep selling locally; online-only tenders try with a 10 s timeout&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F2D9;strokeColor=#A39E2A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="600" y="220" width="260" height="90" as="geometry" />
