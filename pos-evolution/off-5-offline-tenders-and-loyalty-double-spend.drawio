    <mxCell id="ec4" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#2E9E3E;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="o_c2">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="y2" value="yes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#2E9E3E;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="880" y="332" width="44" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ec5" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#C94545;strokeWidth=1.6;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="o_c3">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="n2" value="no" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C94545;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="688" y="402" width="44" height="20" as="geometry" />
    </mxCell>
    <mxCell id="rules" value="Offline rules (design-decisions §2.2)&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;&lt;b&gt;Works offline:&lt;/b&gt; cash · card when the terminal is online or uses its own S&amp;amp;F · earning points · new customers&lt;br&gt;&lt;br&gt;&lt;b&gt;Needs internet:&lt;/b&gt; UPI · redeeming points · gift cards and store credit&lt;br&gt;&lt;br&gt;&lt;b&gt;The POS never holds card data&lt;/b&gt;: the semi-integrated terminal authorises, the POS stores only the terminal's result (approved / stored / declined, masked PAN, auth code).&lt;br&gt;&lt;br&gt;Floor limit and S&amp;amp;F are the acquirer's settings, not ours.&lt;br&gt;&lt;br&gt;&lt;b&gt;Customers created offline&lt;/b&gt; get a ULID on the till; on sync the cloud merges them by phone number and remaps the sale to the surviving customer id.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pending points&lt;/b&gt; become available when the sale's push is acked OK; a rejected sale cancels them.&lt;br&gt;&lt;br&gt;&lt;b&gt;Every offline sale&lt;/b&gt; is written to the SQLite outbox in the same transaction as the sale, so nothing sold is lost if the till restarts.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1470" y="120" width="410" height="700" as="geometry" />
    </mxCell>
    <mxCell id="rules_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1478" y="128" width="22" height="22" as="geometry" />
    </mxCell>

    <!-- ===================== 2 · DOUBLE SPEND ===================== -->
