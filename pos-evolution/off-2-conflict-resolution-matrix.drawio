    <mxCell id="c7d" value="A semi-integrated terminal authorises by itself. If the terminal is offline too: its store-and-forward under the acquirer floor limit, if the acquirer enables it; otherwise decline." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
