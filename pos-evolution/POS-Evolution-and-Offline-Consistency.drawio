      <mxGeometry x="1607" y="254.0" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="CU" value="CATCH-UP&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;drain the outbox (≤ 200 per batch), then pull pages (≤ 500) · selling continues&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="600" y="460" width="260" height="90" as="geometry" />
    </mxCell>
