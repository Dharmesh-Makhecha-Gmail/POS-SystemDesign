      </mxGeometry>
    </mxCell>
    <mxCell id="snap" value="Reading stock fast: snapshots&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;&lt;b&gt;on-hand = last snapshot + Σ movements since it&lt;/b&gt;&lt;br&gt;· snapshot taken nightly per store and item&lt;br&gt;· movements partitioned by month&lt;br&gt;· a read never sums the whole history&lt;br&gt;· a late offline movement just lands after the snapshot&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
