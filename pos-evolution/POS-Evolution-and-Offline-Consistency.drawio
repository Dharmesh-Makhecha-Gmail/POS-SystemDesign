    </mxCell>
    <mxCell id="l3" value="no response for 30 s" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="870" y="196" width="200" height="46" as="geometry" />
    </mxCell>
    <mxCell id="t4" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ON" target="OF">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="250" y="166" /><mxPoint x="1210" y="166" /></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="l4" value="network lost (OS / NIC event)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="520" y="130" width="420" height="30" as="geometry" />
    </mxCell>
    <mxCell id="t5" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#2E9E3E;strokeWidth=1.6;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="OF" target="CU">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="1158" y="505" /></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="l5" value="connection back + health check OK&lt;br&gt;(timer · connection event · Sync now · server hint)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#2E9E3E;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="870" y="446" width="280" height="54" as="geometry" />
    </mxCell>
    <mxCell id="t6" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#2E9E3E;strokeWidth=1.6;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU" target="ON">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="250" y="505" /></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="l6" value="outbox empty and pull finished" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#2E9E3E;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="270" y="466" width="320" height="34" as="geometry" />
    </mxCell>
    <mxCell id="t7" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#C94545;strokeWidth=1.6;dashed=1;dashPattern=8 5;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="CU" target="OF">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="795" y="580" /><mxPoint x="1288" y="580" /></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="l7" value="network drops again during catch-up (progress kept)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#C94545;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="805" y="586" width="470" height="22" as="geometry" />
    </mxCell>
    <mxCell id="t8" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#C94545;strokeWidth=1.6;dashed=1;dashPattern=8 5;exitX=1;exitY=0.33;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="OF" target="RS">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="l8" value="offline &gt; 72 h · outbox over limit · credentials expiring" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#C94545;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1350" y="180" width="240" height="64" as="geometry" />
    </mxCell>
    <mxCell id="t9" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#2E9E3E;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="RS" target="CU">
      <mxGeometry relative="1" as="geometry">
        <Array as="points"><mxPoint x="1730" y="640" /><mxPoint x="665" y="640" /></Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="l9" value="connection back → catch up first; full selling returns when drained" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#2E9E3E;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="900" y="646" width="760" height="22" as="geometry" />
    </mxCell>
    <mxCell id="why" value="Why these limits&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;72 h bounds how stale prices, promos and the PIN cache can get. The outbox limit bounds what a lost till could take with it. Card store-and-forward is the terminal's call, not the POS's.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1310" y="470" width="400" height="104" as="geometry" />
    </mxCell>
    <mxCell id="why_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1318" y="478" width="22" height="22" as="geometry" />
    </mxCell>

    <!-- ===================== B · CAPABILITY MATRIX ===================== -->
    <mxCell id="bB" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="704" width="1876" height="560" as="geometry" />
    </mxCell>
    <mxCell id="bB_t" value="B · What the cashier can do in each state" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#333333;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="712" width="1852" height="24" as="geometry" />
    </mxCell>
    <mxCell id="mh" value="Feature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="748" width="290" height="36" as="geometry" />
    </mxCell>
    <mxCell id="mh0" value="ONLINE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E9E3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
