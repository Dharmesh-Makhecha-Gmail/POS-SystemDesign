    <mxCell id="gX_tag" value="Extracted services · each with a real reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;spacingLeft=26;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
