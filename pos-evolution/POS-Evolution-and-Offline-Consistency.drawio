    </mxCell>
    <mxCell id="bS_t" value="Prerequisites, bottom to top: the version that delivered each step, and what the agent uses it for" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#333333;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="92" width="1852" height="24" as="geometry" />
    </mxCell>
    <mxCell id="blk0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="40" y="760" width="280" height="240" as="geometry" />
    </mxCell>
    <mxCell id="st0" value="v1 · Clean transactions&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Delivered:&lt;/b&gt; receipts, payments and tenders as immutable records.&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent needs it for:&lt;/b&gt; the facts it cites: ‘receipt 1042 was paid by card, refund pending’.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="760" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="768" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="blk1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="344" y="644" width="280" height="356" as="geometry" />
    </mxCell>
    <mxCell id="st1" value="v2 · Central data + device state&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Delivered:&lt;/b&gt; one central copy, device IDs, sync status and last-seen per till.&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent needs it for:&lt;/b&gt; ‘why didn't till 3 sync?’&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="344" y="644" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="352" y="652" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e1" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st0" target="st1">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="blk2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="648" y="528" width="280" height="472" as="geometry" />
    </mxCell>
    <mxCell id="st2" value="v3 · Tenant isolation + search&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Delivered:&lt;/b&gt; TenantID + row-level security; CDC → Elasticsearch history.&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent needs it for:&lt;/b&gt; never leaking across tenants; searching past orders fast.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="648" y="528" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st2_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="656" y="536" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e2" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st1" target="st2">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="blk3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#D9822B;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="952" y="412" width="280" height="588" as="geometry" />
    </mxCell>
    <mxCell id="st3" value="v4 · Integration status&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Delivered:&lt;/b&gt; order state machine, partner webhooks, gateway status per payment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent needs it for:&lt;/b&gt; ‘where is my DoorDash order?’&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#D9822B;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="952" y="412" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st3_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="960" y="420" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e3" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st2" target="st3">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="blk4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1256" y="296" width="280" height="704" as="geometry" />
    </mxCell>
    <mxCell id="st4" value="v5 · APIs, events, telemetry, audit&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Delivered:&lt;/b&gt; stable APIs and events, OpenTelemetry traces and logs, an audit trail.&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent needs it for:&lt;/b&gt; MCP tools: evidence to read and safe, audited writes.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1256" y="296" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st4_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1264" y="304" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e4" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st3" target="st4">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="blk5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="1560" y="180" width="280" height="820" as="geometry" />
    </mxCell>
    <mxCell id="st5" value="AI support copilot&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;RAG over the knowledge base · MCP tools over v5 APIs · guardrails · human approval for refunds and writes · evaluation on real tickets.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1560" y="180" width="280" height="180" as="geometry" />
    </mxCell>
    <mxCell id="st5_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1568" y="188" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="e5" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.1889;exitDx=0;exitDy=0;entryX=0;entryY=0.8333;entryDx=0;entryDy=0;" edge="1" parent="1" source="st4" target="st5">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="base" value="foundations ↑ each step only works because the one below it exists" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=12;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="1012" width="1000" height="24" as="geometry" />
    </mxCell>
    <mxCell id="warn" value="What goes wrong if you add the agent at v1 / v2&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;&lt;b&gt;No tenant boundary:&lt;/b&gt; one prompt injection can read another retailer's data.&lt;br&gt;&lt;b&gt;No audit trail:&lt;/b&gt; you can't show who (or what) changed an order.&lt;br&gt;&lt;b&gt;No APIs:&lt;/b&gt; the agent screen-scrapes or runs raw SQL.&lt;br&gt;&lt;b&gt;Unsafe writes:&lt;/b&gt; refunds with no idempotency key or approval step.&lt;br&gt;&lt;b&gt;No telemetry:&lt;/b&gt; nothing to judge whether its answers were right.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="130" width="860" height="170" as="geometry" />
    </mxCell>
    <mxCell id="warn_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="138" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="rule" value="Rule of thumb&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;Build the agent when you can answer ‘which API would it call, under which tenant, and where is that logged?’ for every action. In this POS that was only true after v5.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="320" width="860" height="90" as="geometry" />
    </mxCell>
    <mxCell id="rule_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="328" width="22" height="22" as="geometry" />
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram name="OFF-01 Sync protocol" id="off-1">
<mxGraphModel dx="1920" dy="2481" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2481" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== TITLE ===================== -->
    <mxCell id="title" value="Offline-first sync · push / ack / retry / gap / pull between the till and the cloud" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=26;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="100" y="14" width="1720" height="44" as="geometry" />
    </mxCell>
    <mxCell id="pb0" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#1F8A7A;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="176" width="1876" height="310" as="geometry" />
    </mxCell>
    <mxCell id="pb0_t" value="1 · Sale while offline — the till never waits for the network" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1F8A7A;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="184" width="1100" height="24" as="geometry" />
    </mxCell>
    <mxCell id="pb1" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#3B6FD6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="502" width="1876" height="614" as="geometry" />
    </mxCell>
    <mxCell id="pb1_t" value="2 · Reconnect → push a batch → idempotent apply → ack the high-water mark" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#3B6FD6;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="510" width="1100" height="24" as="geometry" />
    </mxCell>
    <mxCell id="pb2" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#D9822B;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="1132" width="1876" height="389" as="geometry" />
    </mxCell>
    <mxCell id="pb2_t" value="3 · The ack is lost (timeout) → retry the same batch → nothing is applied twice" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#D9822B;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="1140" width="1100" height="24" as="geometry" />
    </mxCell>
    <mxCell id="pb3" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#C94545;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="1537" width="1876" height="389" as="geometry" />
    </mxCell>
    <mxCell id="pb3_t" value="4 · Gap detected → hold the batch → ask for a resend from the missing seq" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C94545;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="1545" width="1100" height="24" as="geometry" />
    </mxCell>
    <mxCell id="pb4" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#7A6BD6;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="1942" width="1876" height="233" as="geometry" />
    </mxCell>
    <mxCell id="pb4_t" value="5 · Pull master data since the terminal's last sync token (cloud wins)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#7A6BD6;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
