    </mxCell>
    <mxCell id="x0" value="Payments&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;PCI scope&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="956" y="670" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="x1" value="Sync API&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;spiky at open / close&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1258" y="670" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="x2" value="Partner integrations&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;DoorDash, Uber Eats, gateways&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1560" y="670" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="x3" value="Payroll &amp; attendance&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;PII, month-end batch&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="956" y="762" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="x4" value="Notifications&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;SMS / email bursts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1258" y="762" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="x5" value="AI support&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;own quota and guardrails&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1560" y="762" width="290" height="78" as="geometry" />
    </mxCell>
    <mxCell id="nt" value="&lt;b&gt;Split later along module seams.&lt;/b&gt; Module events (SaleCompleted, StockMoved, PriceChanged) are the future service contracts, so extracting a module means moving code, not redesigning it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
