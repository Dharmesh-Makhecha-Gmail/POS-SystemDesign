    <mxCell id="lg0" value="append-only" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="54" y="1076" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg0t" value="insert new rows, sum them; never update" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="254" y="1079" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="lg1" value="device-owned" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="664" y="1076" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg1t" value="one till owns it; no one else writes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="864" y="1079" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="lg2" value="cloud wins" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1274" y="1076" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg2t" value="back office is the only writer; till caches" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1474" y="1079" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="lg3" value="merge + LWW (HLC)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="54" y="1112" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg3t" value="merge new by phone; per-field latest wins" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="254" y="1115" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="lg4" value="online-only" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="664" y="1112" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg4t" value="needs a live cloud check; disabled offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="864" y="1115" width="400" height="20" as="geometry" />
    </mxCell>
    <mxCell id="lg5" value="terminal decides" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#D9822B;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1274" y="1112" width="190" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg5t" value="card terminal's own link / floor limit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
