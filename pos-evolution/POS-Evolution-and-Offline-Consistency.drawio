    <mxCell id="n12" value="&lt;b&gt;Per event, one DB transaction:&lt;/b&gt;&lt;br&gt;INSERT inbox(device, seq) — unique key&lt;br&gt;write domain rows (sale, ledger …)&lt;br&gt;INSERT outbox event · COMMIT" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
