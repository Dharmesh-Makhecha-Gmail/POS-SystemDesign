    <mxCell id="n3" value="&lt;b&gt;One local SQLite transaction&lt;/b&gt;&lt;br&gt;INSERT sale (id = ULID, CHAR(26)) + lines + payments&lt;br&gt;INSERT stock_movement (−qty)&lt;br&gt;INSERT outbox (device 7, seq 41) · COMMIT" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
