</mxGraphModel>
  </diagram>
  <diagram name="OFF-03 Connectivity states" id="off-3">
<mxGraphModel dx="1920" dy="1304" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1304" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== TITLE + FRAME ===================== -->
    <mxCell id="title" value="Till connectivity state machine · what the till does in each state, and what the cashier may still sell" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=26;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="60" y="14" width="1800" height="44" as="geometry" />
    </mxCell>

    <!-- ===================== A · STATE MACHINE ===================== -->
    <mxCell id="bA" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="22" y="84" width="1876" height="600" as="geometry" />
    </mxCell>
    <mxCell id="bA_t" value="A · States and transitions (the till never jumps from OFFLINE straight to ONLINE: it always catches up first)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#333333;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="92" width="1852" height="24" as="geometry" />
    </mxCell>
    <mxCell id="ON" value="ONLINE&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;push every 30 s and after each sale · pull every 5 min or on a server hint&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="120" y="220" width="260" height="90" as="geometry" />
    </mxCell>
    <mxCell id="ON_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="127" y="254.0" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="DG" value="DEGRADED&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;slow or partial: keep selling locally; online-only tenders try with a 10 s timeout&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F2D9;strokeColor=#A39E2A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="600" y="220" width="260" height="90" as="geometry" />
    </mxCell>
    <mxCell id="DG_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="607" y="254.0" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="OF" value="OFFLINE&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;sell from the local SQLite DB · outbox grows · online-only tenders off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#D9822B;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1080" y="220" width="260" height="90" as="geometry" />
    </mxCell>
    <mxCell id="OF_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1087" y="254.0" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="RS" value="RESTRICTED&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;cash only (+ card if the terminal is online) · manager override with a reason, audited&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=middle;spacingLeft=32;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1600" y="220" width="260" height="90" as="geometry" />
    </mxCell>
