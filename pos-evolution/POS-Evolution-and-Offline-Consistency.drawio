      <mxGeometry x="880" y="222" width="44" height="20" as="geometry" />
    </mxCell>
    <mxCell id="ec3" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#C94545;strokeWidth=1.6;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2">
      <mxGeometry relative="1" as="geometry">
