  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- ===================== TITLE ===================== -->
    <mxCell id="title" value="POS evolution · v1 → v2: from one store on a LAN to many stores that sell offline" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=26;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="80" y="14" width="1760" height="44" as="geometry" />
