    <mxCell id="c2a" value="Products &amp; prices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="280" width="230" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c2b" value="Nobody at the till" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="270" y="280" width="260" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c2c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="530" y="280" width="220" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c2d" value="Price versions with effective-from dates. Each sale line keeps the price actually charged, so a later price change never rewrites a past sale." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="750" y="280" width="600" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c2e" value="Old price until the next pull; the receipt always matches what was charged." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1350" y="280" width="530" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c2r0" value="cloud wins" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="544" y="304.0" width="192" height="26" as="geometry" />
    </mxCell>
    <mxCell id="c3a" value="Promotions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="354" width="230" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c3b" value="Nobody at the till" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="270" y="354" width="260" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c3c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="530" y="354" width="220" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c3d" value="The last synced set is used offline with its valid-to date; a promo stops at expiry even if the till is still offline." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="750" y="354" width="600" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c3e" value="An expired promo is not applied; a new promo appears after the next pull." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1350" y="354" width="530" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c3r0" value="cloud wins" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="544" y="378.0" width="192" height="26" as="geometry" />
    </mxCell>
    <mxCell id="c4a" value="Customer profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="428" width="230" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c4b" value="Any till (new customer, edits)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="270" y="428" width="260" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c4c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="530" y="428" width="220" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c4d" value="Customers created offline are merged by phone number. Edits to an existing profile: field-level last-write-wins by hybrid logical clock (email from till A and address from till B are both kept)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="750" y="428" width="600" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c4e" value="Duplicates are rare; the latest edit of each field wins." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1350" y="428" width="530" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c4r0" value="merge + LWW (HLC)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
