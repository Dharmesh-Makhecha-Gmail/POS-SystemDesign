      <mxGeometry x="10" y="70" width="1900" height="1000" as="geometry" />
    </mxCell>
    <mxCell id="bS" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
