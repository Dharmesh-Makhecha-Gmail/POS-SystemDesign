    <mxCell id="c1b" value="Every till, as movements only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="270" y="206" width="260" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c1c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="530" y="206" width="220" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c1d" value="Till writes a −3 movement. The cloud sums movements per item and store and never overwrites a quantity. A negative result goes to an exception queue." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="750" y="206" width="600" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c1e" value="Stock can show negative for a while; the store manager gets a 'count or transfer' task." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1350" y="206" width="530" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c1r0" value="append-only" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
