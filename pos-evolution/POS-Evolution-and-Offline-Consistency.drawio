    <mxCell id="c0c" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="530" y="132" width="220" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c0d" value="ULID id + receipt S01-T07-000041 (StoreCode-TerminalCode-Seq). Insert-only, never updated; a void or return is a new row." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="750" y="132" width="600" height="74" as="geometry" />
    </mxCell>
    <mxCell id="c0e" value="The sale completes instantly; it shows in the back office after the next push." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1350" y="132" width="530" height="74" as="geometry" />
