    <!-- ===================== TITLE + FRAME ===================== -->
    <mxCell id="title" value="Why AI agents come last · each version laid a step the support copilot stands on" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=26;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="100" y="14" width="1720" height="44" as="geometry" />
