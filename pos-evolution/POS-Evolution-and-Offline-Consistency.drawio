    </mxCell>
    <mxCell id="cD" value="Decision: what we changed" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="530" width="560" height="28" as="geometry" />
    </mxCell>
    <mxCell id="cR" value="Result: what it bought us" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="530" width="600" height="28" as="geometry" />
    </mxCell>
    <mxCell id="p0" value="The model only knew 'a sale at a till'&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;A web order, a DoorDash order and a till sale had nowhere common to live.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="570" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d0" value="Order is first-class, with a channel&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Order(channel = till | web | DoorDash | Uber Eats). A till sale is an order paid on the spot.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="570" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r0" value="One model for every channel&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Reports, refunds, tax and loyalty work the same way whatever the channel.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="570" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep0" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="d0">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed0" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="r0">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p1" value="Orders have a lifecycle&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Remote orders are placed, accepted, prepared, picked up or cancelled. A till sale is instant.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="660" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="668" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d1" value="Order state machine + kitchen display&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Placed → Accepted → Preparing → Ready → Completed / Cancelled, with timeouts per channel.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="660" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="668" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r1" value="Clear status for staff and partners&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;The kitchen, the courier and the customer all see the same state.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="660" width="600" height="78" as="geometry" />
    </mxCell>
