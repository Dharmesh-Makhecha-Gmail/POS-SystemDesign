    <mxCell id="ml9" value="POST /sync/push · tenant T42 · device 7 · seq 41–60&lt;br&gt;Idempotency-Key: dev7:41-60" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
