    <!-- ===================== 6 · ORDER RULES ===================== -->
    <mxCell id="b6" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDFDFD;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
