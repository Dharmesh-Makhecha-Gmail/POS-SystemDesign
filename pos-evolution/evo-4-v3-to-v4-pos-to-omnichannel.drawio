    <mxCell id="bF_t" value="B · Forces → Decision → Result" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#333333;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="34" y="498" width="1852" height="24" as="geometry" />
    </mxCell>
    <mxCell id="cF" value="Force: what hurt" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="530" width="560" height="28" as="geometry" />
    </mxCell>
    <mxCell id="cD" value="Decision: what we changed" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="530" width="560" height="28" as="geometry" />
    </mxCell>
    <mxCell id="cR" value="Result: what it bought us" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="530" width="600" height="28" as="geometry" />
    </mxCell>
    <mxCell id="p0" value="The model only knew 'a sale at a till'&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;A web order, a DoorDash order and a till sale had nowhere common to live.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="570" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d0" value="Order is first-class, with a channel&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Order(channel = till | web | DoorDash | Uber Eats). A till sale is an order paid on the spot.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="570" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r0" value="One model for every channel&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Reports, refunds, tax and loyalty work the same way whatever the channel.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="570" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r0_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="578" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep0" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="d0">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed0" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="r0">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p1" value="Orders have a lifecycle&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Remote orders are placed, accepted, prepared, picked up or cancelled. A till sale is instant.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="660" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="668" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d1" value="Order state machine + kitchen display&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Placed → Accepted → Preparing → Ready → Completed / Cancelled, with timeouts per channel.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="660" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="668" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r1" value="Clear status for staff and partners&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;The kitchen, the courier and the customer all see the same state.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="660" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r1_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="668" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep1" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d1">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed1" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="r1">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p2" value="One gateway, one country&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Each new country needed a local gateway, and a gateway outage stopped every card sale.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="750" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p2_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="758" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d2" value="Payment orchestration&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Route by country, method and fee; fail over to a second gateway; idempotency key on every charge.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="750" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d2_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="758" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r2" value="No double charges, fewer lost sales&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Daily reconciliation per gateway matches every charge to an order.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="750" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r2_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="758" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep2" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d2">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed2" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="r2">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p3" value="Partner APIs are volatile&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;DoorDash and Uber Eats change payloads, resend webhooks and deliver duplicates.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="840" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p3_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="848" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d3" value="Partner adapters (anti-corruption layer)&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Translate partner models; verify HMAC-signed webhooks; dedupe; retry with backoff; dead-letter queue.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="840" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d3_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="848" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r3" value="Partner churn stays at the edge&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;A partner API change touches one adapter, not the order model.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="840" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r3_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="848" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep3" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d3">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed3" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="r3">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p4" value="Selling the same stock twice&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;The till, the web shop and two delivery apps sell from the same shelf.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="930" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p4_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="938" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d4" value="Stock reservation across channels&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Reserve on accept, release on cancel or timeout; publish availability to channels.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="930" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d4_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="938" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r4" value="Fewer cancelled online orders&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Out-of-stock items disappear from partner menus within seconds.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="1280" y="930" width="600" height="78" as="geometry" />
    </mxCell>
    <mxCell id="r4_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="1288" y="938" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="ep4" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d4">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="ed4" style="edgeStyle=none;html=1;rounded=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="r4">
      <mxGeometry relative="1" as="geometry">
      </mxGeometry>
    </mxCell>
    <mxCell id="p5" value="Menus out of sync&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;Prices and items differed between the POS, the web shop and partner apps.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="40" y="1020" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="p5_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="48" y="1028" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="d5" value="Menu &amp; availability publishing&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;The back office is the source; changes are pushed to the web shop and partners.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
      <mxGeometry x="660" y="1020" width="560" height="78" as="geometry" />
    </mxCell>
    <mxCell id="d5_ic" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
      <mxGeometry x="668" y="1028" width="22" height="22" as="geometry" />
    </mxCell>
    <mxCell id="r5" value="One menu everywhere&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;One price change, every channel, with an audit of what was published when.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
