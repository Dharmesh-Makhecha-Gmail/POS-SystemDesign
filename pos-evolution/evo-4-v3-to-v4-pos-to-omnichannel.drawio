      <mxGeometry x="34" y="1140" width="1852" height="24" as="geometry" />
    </mxCell>
    <mxCell id="keep" value="What we deliberately did NOT change&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:12px;margin-top:4px&quot;&gt;Tenancy, shards, CDC → search and the offline Store App. Still one back-office deployable: payments, partners and sync shipped together, which is what forced v5 (evo-5).&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
