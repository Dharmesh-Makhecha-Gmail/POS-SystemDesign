        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Pricing &amp; Promotions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Terms:&lt;/b&gt; PriceList, PriceEntry, Promotion, Stacking, ChannelOverride&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Events:&lt;/b&gt; PriceChanged · PromotionActivated · PromotionEnded&lt;/span&gt;" vertex="1">
