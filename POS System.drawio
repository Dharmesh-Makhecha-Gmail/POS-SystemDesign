        <mxCell id="nKey" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Connectors&lt;/b&gt;&lt;br&gt;(G) degraded answer → output guardrails&lt;br&gt;(H) hand off to a human agent&lt;br&gt;(N) action rejected → explain, resolve check&lt;br&gt;(E) escalate to Tier-2 / engineering&lt;br&gt;(W) back to wrap-up" vertex="1">
