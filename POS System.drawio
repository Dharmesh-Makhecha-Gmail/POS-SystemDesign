        </mxCell>
        <mxCell id="tenant_TenantID" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#777777;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;spacingLeft=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="TenantID" vertex="1">
