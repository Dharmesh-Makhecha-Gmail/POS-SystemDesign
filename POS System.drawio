        <mxCell id="dSh_s1_c0" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#D9822B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=9;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Elasticsearch" vertex="1">
