        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Terms:&lt;/b&gt; Order, Channel, Fulfilment, PickupCode, Substitution, SLA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Events:&lt;/b&gt; OrderPlaced · OrderAccepted · OrderReady · OrderCompleted · OrderCancelled&lt;/span&gt;" vertex="1">
          <mxGeometry height="114" width="365" x="410" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Cart &amp; Checkout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Terms:&lt;/b&gt; Cart, Reservation, CheckoutSession, PickupSlot, DeliveryZone&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Events:&lt;/b&gt; CartConvertedToOrder · CartExpired&lt;/span&gt;" vertex="1">
