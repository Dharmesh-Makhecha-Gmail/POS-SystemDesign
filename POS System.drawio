        <mxCell id="tenantT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C94545;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="every red TenantID row points here: a logical link to the catalog DB, no FK across databases" vertex="1">
          <mxGeometry height="60" width="300" x="1610" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;employees.Status: ACTIVE, ON_NOTICE, EXITED&lt;br&gt;employment_contracts.Type: PERMANENT, FIXED_TERM, PART_TIME, INTERN&lt;br&gt;employee_store_assignments.Role: CASHIER, SUPERVISOR, STORE_MANAGER, STOCK&lt;br&gt;employee_devices.Platform: ANDROID, IOS · Status: ACTIVE, REVOKED&lt;br&gt;attendance_methods.Method: BIOMETRIC, RFID, FACE_TABLET, MOBILE_GEO,&lt;br&gt;&amp;nbsp;&amp;nbsp;QR, POS_PIN, WEB, MANUAL&lt;br&gt;attendance_devices.Type: BIOMETRIC, FACE, RFID, KIOSK · Status: ONLINE, OFFLINE, RETIRED&lt;br&gt;attendance_days.Status: PRESENT, HALF_DAY, ABSENT, WEEKLY_OFF, HOLIDAY, ON_LEAVE&lt;br&gt;regularization_requests.Status / leave_requests.Status: PENDING, APPROVED, REJECTED, CANCELLED&lt;br&gt;leave_policies.Scope: COUNTRY, STATE, STORE, GRADE · leave_requests.HalfDay: NONE, FIRST, SECOND" vertex="1">
          <mxGeometry height="230" width="540" x="1400" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• TenantID (red row) leads every PK and index; FKs are composite, e.g. (TenantID, EmployeeID).&lt;br&gt;• Each service owns its tables. “(ref)” boxes are read-only copies kept up to date from events&lt;br&gt;&amp;nbsp;&amp;nbsp;(EmployeeChanged, StoreChanged), so no FK crosses a service.&lt;br&gt;• attendance_days is PARTITION BY RANGE (WorkDate), one partition per month; WorkDate is in the PK.&lt;br&gt;• Raw punches live in Cosmos DB; attendance_days is recomputed from them and locked for payroll.&lt;br&gt;• ApproverID and ManagerID point to employees (no line drawn, to keep lines from crossing).&lt;br&gt;• PII (phone, bank) is encrypted with a Key Vault key; biometric templates stay on the device." vertex="1">
          <mxGeometry height="250" width="490" x="1960" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy · red row = TenantID · ▦ = monthly partitions" vertex="1">
          <mxGeometry height="24" width="1200" x="40" y="1520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
