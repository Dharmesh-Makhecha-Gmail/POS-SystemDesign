        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;Channel: DOORDASH, UBER_EATS (more later)&lt;br&gt;connections.Status: ONLINE, PAUSED, DISCONNECTED&lt;br&gt;menu_publications.Trigger: CDC, STOCK_OUT,&lt;br&gt;&amp;nbsp;&amp;nbsp;SCHEDULED, MANUAL&lt;br&gt;menu_publications.Status: RUNNING, OK, PARTIAL, FAILED&lt;br&gt;events.EventType: ORDER_CREATED, ORDER_UPDATED,&lt;br&gt;&amp;nbsp;&amp;nbsp;ORDER_CANCELLED, DELIVERY_STATUS&lt;br&gt;events.Status: RECEIVED, PROCESSED, DUPLICATE,&lt;br&gt;&amp;nbsp;&amp;nbsp;REJECTED_UNMAPPED, FAILED&lt;br&gt;availability.State: ONLINE, PAUSED, RESUMED&lt;br&gt;availability.Reason: HEARTBEAT_LOST, MANUAL, HOURS&lt;br&gt;courier_jobs.Status: REQUESTED, ASSIGNED, PICKED_UP,&lt;br&gt;&amp;nbsp;&amp;nbsp;DELIVERED, CANCELLED, FAILED&lt;br&gt;payouts.Status: IMPORTED, RECONCILED, POSTED&lt;br&gt;payout_lines.MatchStatus: MATCHED, MISMATCH, MISSING" vertex="1">
          <mxGeometry height="470" width="345" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• One channel_connections row per store per aggregator; its OAuth tokens / keys sit in&lt;br&gt;&amp;nbsp;&amp;nbsp;Key Vault, only the reference is stored here.&lt;br&gt;• (TenantID, ConnectionID, ExternalEventId) unique: a webhook sent twice is stored once;&lt;br&gt;&amp;nbsp;&amp;nbsp;orders are unique on (TenantID, Channel, ExternalOrderId) in ERD 1.&lt;br&gt;• Unmapped item in an inbound order → event REJECTED_UNMAPPED, store alerted.&lt;br&gt;• Every terminal offline &gt; 2 min → store PAUSED on the aggregators (availability log),&lt;br&gt;&amp;nbsp;&amp;nbsp;RESUMED when a terminal reconnects.&lt;br&gt;• courier_jobs = DoorDash Drive / Uber Direct deliveries for WEB orders.&lt;br&gt;• Aggregator collects the money: payouts are imported and posted to accounting." vertex="1">
          <mxGeometry height="175" width="600" x="1560" y="100" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy · red row = TenantID · ▦ = monthly partitions" vertex="1">
          <mxGeometry height="24" width="1300" x="40" y="1280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
