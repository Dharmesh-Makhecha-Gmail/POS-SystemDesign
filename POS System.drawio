        <mxCell id="slo" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C94FD6;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#F7E3F9&quot;&gt;SLI&lt;/th&gt;&lt;th style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#F7E3F9&quot;&gt;Target (SLO)&lt;/th&gt;&lt;th style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#F7E3F9&quot;&gt;Alert when&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;API p95 latency (REST / GraphQL)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;≤ 300 ms reads · ≤ 800 ms writes&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;burn rate &gt; 2 % budget in 1 h&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;Availability per tenant&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;99.9 % pooled · 99.95 % dedicated&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;multi-window burn (1 h / 6 h)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;Payment success per gateway&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;tech errors &lt; 1 % of attempts&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;5 min window, per gateway&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;Offline sync lag (terminal → cloud)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;p95 &lt; 2 min when online&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;&gt; 10 min for a store&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;CDC lag (binlog → consumers)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;p95 &lt; 5 s&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;&gt; 60 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;Attendance punch ingestion lag&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;p95 &lt; 30 s&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;&gt; 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;Payroll run duration (10k employees)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;&lt; 30 min&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FFFFFF&quot;&gt;&gt; 60 min or a failed step&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;Monthly error budget&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;43 min at 99.9 %&lt;/td&gt;&lt;td style=&quot;border:1px solid #CCCCCC;padding:3px 6px;text-align:left;background:#FAFAFA&quot;&gt;50 % spent → freeze risky deploys&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
