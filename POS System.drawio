        </mxCell>
        <mxCell id="dSh_s2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B6FD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Media" vertex="1">
