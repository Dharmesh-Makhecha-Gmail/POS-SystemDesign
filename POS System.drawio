        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;Method: CARD, UPI, WALLET, NETBANKING, BNPL, TOKEN&lt;br&gt;payment_intents.Status: CREATED, PROCESSING, SUCCEEDED,&lt;br&gt;&amp;nbsp;&amp;nbsp;FAILED, CANCELLED, PARTIALLY_REFUNDED, REFUNDED&lt;br&gt;payment_attempts.Status: PENDING, AUTHORISED, CAPTURED,&lt;br&gt;&amp;nbsp;&amp;nbsp;DECLINED, ERROR, TIMEOUT, UNKNOWN&lt;br&gt;routes.Channel: POS, WEB, DOORDASH, UBER_EATS, ANY&lt;br&gt;accounts.Environment: TEST, LIVE · Status: ACTIVE, DISABLED&lt;br&gt;webhook.Status: RECEIVED, PROCESSED, DUPLICATE, FAILED&lt;br&gt;refunds.Status: PENDING, SUCCEEDED, FAILED&lt;br&gt;settlement_lines.MatchStatus: MATCHED, AMOUNT_MISMATCH,&lt;br&gt;&amp;nbsp;&amp;nbsp;MISSING_IN_POS, MISSING_IN_REPORT" vertex="1">
          <mxGeometry height="250" width="345" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• One intent per payment; one attempt per gateway call.&lt;br&gt;&amp;nbsp;&amp;nbsp;Fallback gateway only on timeout / 5xx / circuit open,&lt;br&gt;&amp;nbsp;&amp;nbsp;never after a bank decline.&lt;br&gt;• IdempotencyKey = {IntentID}-{AttemptNo}; a timed-out call&lt;br&gt;&amp;nbsp;&amp;nbsp;is resolved by a status query before any retry.&lt;br&gt;• Final status comes from webhook / status query,&lt;br&gt;&amp;nbsp;&amp;nbsp;never from the browser redirect.&lt;br&gt;• No card numbers stored: hosted fields + gateway tokens.&lt;br&gt;• Gateway secrets live in Key Vault; only the reference here.&lt;br&gt;• Nightly reconciliation matches settlement_lines to attempts;&lt;br&gt;&amp;nbsp;&amp;nbsp;fees and net payout post to accounting." vertex="1">
          <mxGeometry height="280" width="345" x="40" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy · red row = TenantID · ▦ = monthly partitions" vertex="1">
          <mxGeometry height="24" width="1300" x="40" y="1450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
