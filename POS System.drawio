        <mxCell id="tenantT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C94545;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="every table&#39;s red TenantID row points here: a logical link to the catalog DB, no FK across databases" vertex="1">
          <mxGeometry height="44" width="300" x="1180" y="180" as="geometry" />
        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;sales.Status: OPEN, PAID, CANCELLED, VOIDED&lt;br&gt;payments.Method: CASH, CREDIT, DEBIT, UPI, POINTS&lt;br&gt;payments.Status: PENDING, APPROVED, DECLINED,&lt;br&gt;&amp;nbsp;&amp;nbsp;VOIDED, REFUNDED&lt;br&gt;loyalty_ledger.Type: EARN, REDEEM, HOLD, RELEASE, ADJUST&lt;br&gt;customers.ContactPref: SMS, EMAIL, BOTH, NONE&lt;br&gt;outbox.Channel: SMS, EMAIL · Status: PENDING, SENT, FAILED&lt;br&gt;stock_movements.Reason: SALE, RETURN, GRN,&lt;br&gt;&amp;nbsp;&amp;nbsp;TRANSFER_IN, TRANSFER_OUT, ADJUST, COUNT&lt;br&gt;stock_movements.SourceType: SALE, GRN, TRANSFER, COUNT, MANUAL&lt;br&gt;stock_transfers.Status: DRAFT, IN_TRANSIT, RECEIVED, CANCELLED" vertex="1">
          <mxGeometry height="250" width="340" x="1180" y="600" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Multi-tenant + scale rules&lt;/b&gt;&lt;br&gt;• TenantID (red row) leads every PK, unique key and index; FKs are composite,&lt;br&gt;&amp;nbsp;&amp;nbsp;e.g. (TenantID, SaleID). A tenant lives on exactly one shard.&lt;br&gt;• ▦ tables are PARTITION BY RANGE (BusinessDate), one partition per month;&lt;br&gt;&amp;nbsp;&amp;nbsp;the partition column is in the PK, e.g. (TenantID, SaleID, BusinessDate).&lt;br&gt;&amp;nbsp;&amp;nbsp;Old months are exported to Blob, then the partition is dropped.&lt;br&gt;• Cross-tenant queries are forbidden: EF Core global filter on TenantID.&lt;br&gt;• CHAR(26) ids are ULIDs made on the till: a re-sent push is ignored, not duplicated.&lt;br&gt;• stock_movements and loyalty_ledger are append-only; QtyOnHand, PointsBalance are cached.&lt;br&gt;• Elasticsearch (customers, receipts) and Fabric are fed by CDC from this shard." vertex="1">
          <mxGeometry height="200" width="720" x="1180" y="890" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy · red row = TenantID · ▦ = monthly partitions" vertex="1">
          <mxGeometry height="24" width="1000" x="1180" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
