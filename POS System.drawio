          <mxGeometry height="26" width="499.19999999999993" x="40" y="750" as="geometry" />
        </mxCell>
        <mxCell id="gCdc_ic" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" value="" vertex="1">
