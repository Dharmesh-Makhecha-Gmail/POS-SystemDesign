        <mxCell id="r_tokshop" edge="1" parent="1" source="tok_ShopperAccountID" style="edgeStyle=none;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;startArrow=ERmany;startFill=0;startSize=12;endArrow=ERmandOne;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7812;entryDx=0;entryDy=0;" target="shopT">
