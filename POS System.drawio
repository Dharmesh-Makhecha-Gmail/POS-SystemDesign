        <mxCell id="lSleep" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#3B6FD6;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="sleep until the&lt;br&gt;next trigger" vertex="1">
          <mxGeometry height="30" width="140" x="240" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Conflict-resolution rules&lt;/b&gt;&lt;br&gt;• Masters (items, prices, tax, promos): cloud wins, tills never edit them&lt;br&gt;• Stock: append-only stock_movements from every till; cloud recomputes&lt;br&gt;&amp;nbsp;&amp;nbsp;on-hand, so there is nothing to conflict&lt;br&gt;• Customers created offline: client ID kept; cloud merges duplicates&lt;br&gt;&amp;nbsp;&amp;nbsp;by phone and returns the surviving ID on the next pull&lt;br&gt;• Loyalty: EARN works offline; REDEEM is online-only (no double spend)&lt;br&gt;• Sales / payments: immutable once synced; fixes are new rows&lt;br&gt;&amp;nbsp;&amp;nbsp;(return, void, refund), never updates&lt;br&gt;• Idempotency: client IDs (ULID) + &#39;already seen?&#39; check = safe retries&lt;br&gt;• Ordering: oldest first per till; a sale and its tenders travel together" vertex="1">
          <mxGeometry height="250" width="650" x="660" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="connKey" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#333333;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Ⓣ = trigger again · Ⓟ = next push batch · Ⓠ = next pull page" vertex="1">
          <mxGeometry height="24" width="650" x="660" y="1460" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
