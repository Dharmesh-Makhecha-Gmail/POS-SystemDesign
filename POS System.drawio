        <mxCell id="guards" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.8;fontColor=#1A1A1A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=8;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Loop guards &amp; bulkheads&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:11px;margin-top:4px&quot;&gt;&lt;b&gt;Per turn:&lt;/b&gt; max 8 agent steps · 10 tool calls · 60k tokens · 30 s&lt;br&gt;→ stop, summarise what was found, hand to a human&lt;br&gt;&lt;br&gt;&lt;b&gt;Bulkheads:&lt;/b&gt; interactive chat and batch work (harvesting, evaluations) use separate pods, separate model deployments and separate quotas; batch goes through a queue.&lt;br&gt;&lt;br&gt;&lt;b&gt;Streaming:&lt;/b&gt; target first token &lt; 2 s; a partial answer is marked if the turn is cut off.&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="580" x="1290" y="1000" as="geometry" />
