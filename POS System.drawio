        <mxCell id="rW" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#1F8A7A;strokeWidth=2;fontColor=#1A1A1A;fontSize=11;fontStyle=1;verticalAlign=middle;spacingLeft=34;spacingRight=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Service write stores&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;[MySQL / Cosmos DB]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#444444&quot;&gt;owned by one service each&lt;/span&gt;" vertex="1">
