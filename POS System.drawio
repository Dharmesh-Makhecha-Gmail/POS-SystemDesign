        <mxCell id="nBud" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Budget check before every call&lt;/b&gt;&lt;br&gt;over budget → compress tool results → shrink history → drop lowest-scoring chunks&lt;br&gt;layers 1–4 are never cut · total checked with the model&#39;s tokenizer" vertex="1">
