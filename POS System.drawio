        <mxCell id="nStore" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Where each table lives&lt;/b&gt;&lt;br&gt;&lt;b&gt;MySQL&lt;/b&gt; (Support service DB, blue / green headers): tickets, conversations, feedback, approvals, harvest_candidates, kb_articles, prompt_versions, eval_runs, eval_results&lt;br&gt;&lt;b&gt;Cosmos DB&lt;/b&gt; (purple headers; hierarchical partition key /tenantId/conversationId or /tenantId/yyyyMM; TTL per tenant policy): messages, ai_runs, ai_steps, tool_calls, retrieval_logs, guardrail_events, circuit_breaker_events&lt;br&gt;&lt;b&gt;Azure AI Search&lt;/b&gt; (orange header): kb_chunks index · hybrid BM25 + vector + semantic ranker · tenant / ACL as filterable fields&lt;br&gt;Message and query text is stored redacted (PII removed); raw prompts are never stored." vertex="1">
          <mxGeometry height="150" width="640" x="40" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;messages.Role: USER, ASSISTANT, AGENT, TOOL, SYSTEM&lt;br&gt;ai_steps.Agent: SUPERVISOR, TRIAGE, KNOWLEDGE, DIAGNOSTICS, COMMERCE_OPS, ACCOUNT, HR, ESCALATION, QA&lt;br&gt;ai_runs.FallbackLevel: 0 primary · 1 2nd region · 2 smaller model · 3 semantic cache · 4 KB links · 5 human&lt;br&gt;guardrail_events.Stage: INPUT, RETRIEVAL, TOOL, OUTPUT · Action: ALLOW, REDACT, FLAG, BLOCK&lt;br&gt;tool_calls.Status: OK, ERROR, TIMEOUT, DENIED, AWAITING_APPROVAL · approvals.Decision: APPROVED, REJECTED, EXPIRED&lt;br&gt;harvest_candidates.Status: PENDING, APPROVED, EDITED, REJECTED, DUPLICATE · kb_articles.Source: MANUAL, HARVESTED&lt;br&gt;prompt_versions.Status: DRAFT, AB_TEST, ACTIVE, RETIRED · circuit_breaker_events.State: OPEN, HALF_OPEN, CLOSED" vertex="1">
          <mxGeometry height="340" width="320" x="1400" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;TenantID leads every key and every Cosmos partition key; queries always filter on it.&lt;br&gt;kb_chunks are rebuilt from kb_articles (published versions only).&lt;br&gt;Write tool calls need an approval row; denied calls are kept for audit." vertex="1">
          <mxGeometry height="80" width="640" x="40" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · bar = exactly one · circle + bar = zero or one · red TenantID row = tenant key" vertex="1">
          <mxGeometry height="22" width="660" x="720" y="1560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
