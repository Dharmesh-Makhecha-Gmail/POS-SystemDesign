        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;tenants.Status: PROVISIONING, ACTIVE, READ_ONLY,&lt;br&gt;&amp;nbsp;&amp;nbsp;SUSPENDED, DELETED&lt;br&gt;tenant_subscriptions.Status: TRIAL, ACTIVE, PAST_DUE, CANCELLED&lt;br&gt;shards.Mode: POOLED, DEDICATED&lt;br&gt;shards.Status: ONLINE, DRAINING, FULL, OFFLINE&lt;br&gt;tenant_domains.Type: SUBDOMAIN, CUSTOM&lt;br&gt;tenant_domains.ValidationStatus: PENDING, VALIDATED, FAILED&lt;br&gt;tenant_domains.CertStatus: PENDING, ISSUED, EXPIRING, FAILED&lt;br&gt;shard_migrations.Phase: SNAPSHOT, CATCH_UP, READ_ONLY,&lt;br&gt;&amp;nbsp;&amp;nbsp;CUTOVER, CLEANUP&lt;br&gt;shard_migrations.Status: RUNNING, DONE, FAILED, ROLLED_BACK&lt;br&gt;provisioning_jobs.Type: CREATE_TENANT, MOVE_SHARD,&lt;br&gt;&amp;nbsp;&amp;nbsp;ADD_DOMAIN, DELETE_TENANT&lt;br&gt;provisioning_jobs.Status / steps.Status: QUEUED,&lt;br&gt;&amp;nbsp;&amp;nbsp;RUNNING, DONE, FAILED" vertex="1">
          <mxGeometry height="320" width="400" x="1180" y="110" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;• Tiny global DB: one zone-redundant primary + 1 replica; not sharded.&lt;br&gt;• The tenant → shard map is cached in Redis (1 h TTL) and evicted at migration cutover.&lt;br&gt;• TenantID (ULID) is created here and copied into every shard table.&lt;br&gt;• Slug = subdomain: {slug}.yourpos.com (wildcard CNAME to Front Door).&lt;br&gt;• Custom domain: tenant adds CNAME + TXT _dnsauth; when validated, Front Door&lt;br&gt;&amp;nbsp;&amp;nbsp;issues the TLS cert (CertStatus).&lt;br&gt;• New tenants go to the shard in their region with the most free CapacityUnits;&lt;br&gt;&amp;nbsp;&amp;nbsp;a big tenant can be moved to a DEDICATED shard (shard_migrations).&lt;br&gt;• plans limits are enforced by API Management quotas and the Core API." vertex="1">
          <mxGeometry height="310" width="400" x="1180" y="450" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one" vertex="1">
          <mxGeometry height="24" width="700" x="40" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
