        <mxCell id="lFrom" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#777777;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="from" vertex="1">
          <mxGeometry height="18" width="36" x="1842" y="168" as="geometry" />
        </mxCell>
        <mxCell id="lTo" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#777777;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="to" vertex="1">
          <mxGeometry height="18" width="36" x="1842" y="196" as="geometry" />
        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;sales.Status: OPEN, PAID, CANCELLED, VOIDED&lt;br&gt;payments.Method: CASH, CREDIT, DEBIT, UPI, POINTS&lt;br&gt;payments.Status: PENDING, APPROVED, DECLINED,&lt;br&gt;&amp;nbsp;&amp;nbsp;VOIDED, REFUNDED&lt;br&gt;loyalty_ledger.Type: EARN, REDEEM, HOLD, RELEASE, ADJUST&lt;br&gt;customers.ContactPref: SMS, EMAIL, BOTH, NONE&lt;br&gt;outbox.Channel: SMS, EMAIL · Status: PENDING, SENT, FAILED&lt;br&gt;stock_movements.Reason: SALE, RETURN, GRN,&lt;br&gt;&amp;nbsp;&amp;nbsp;TRANSFER_IN, TRANSFER_OUT, ADJUST, COUNT&lt;br&gt;stock_movements.SourceType: SALE, GRN, TRANSFER, COUNT, MANUAL&lt;br&gt;stock_transfers.Status: DRAFT, IN_TRANSIT, RECEIVED, CANCELLED" vertex="1">
          <mxGeometry height="250" width="340" x="1180" y="600" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;• CHAR(26) ids are ULIDs made on the till, so an offline sale keeps its id&lt;br&gt;&amp;nbsp;&amp;nbsp;and a re-sent push is ignored, not duplicated.&lt;br&gt;• stock_movements and loyalty_ledger are append-only: two offline tills never&lt;br&gt;&amp;nbsp;&amp;nbsp;conflict. inventory.QtyOnHand and PointsBalance are cached sums.&lt;br&gt;• SourceType + SourceID point at the sale, GRN, transfer or count (no FK line).&lt;br&gt;• sales.SyncedAt null = the sale exists only on the till so far.&lt;br&gt;• Same tables on the till (SQLite), filtered to that store&#39;s rows." vertex="1">
          <mxGeometry height="160" width="700" x="1180" y="890" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy of a table from ERD 1" vertex="1">
          <mxGeometry height="24" width="900" x="1180" y="1065" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
