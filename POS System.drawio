        <mxCell id="s11_t" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1A1A1A;fontSize=10;spacing=0;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Query.salesSummary(range, groupBy): [Kpi]&lt;br&gt;Query.storeKpis(storeId, range)&lt;br&gt;Query.channelMix(range)&lt;br&gt;(reads Fabric read model; no writes)" vertex="1">
          <mxGeometry height="98" width="386" x="1362" y="1003" as="geometry" />
        </mxCell>
        <mxCell id="nRoot" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Root operations (sample)&lt;/b&gt;&lt;br&gt;query StoreDashboard($store: ID!) {&lt;br&gt;&amp;nbsp;&amp;nbsp;storeKpis(storeId: $store, range: TODAY) { … }&lt;br&gt;&amp;nbsp;&amp;nbsp;orders(storeId: $store, status: RECEIVED, first: 20) { … }&lt;br&gt;}&lt;br&gt;mutation { acceptOrder(id: &quot;…&quot;) { order { status } errors { code message } } }&lt;br&gt;subscription { orderUpdated(storeId: &quot;…&quot;) { id status } }" vertex="1">
          <mxGeometry height="165" width="570" x="40" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="nUse" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Which BFF uses what&lt;/b&gt;&lt;br&gt;&lt;b&gt;Web BFF:&lt;/b&gt; back-office (catalog, pricing, purchasing, inventory), reporting, HR / payroll admin, employee self-service, desktop POS online views&lt;br&gt;&lt;b&gt;Mobile BFF:&lt;/b&gt; store tablet (orders queue, availability), manager app (approvals, live sales), employee app (attendance, leave, payslips)&lt;br&gt;&lt;b&gt;Not via GraphQL:&lt;/b&gt; offline sync (REST /v1/sync), partner APIs (REST), webhooks" vertex="1">
          <mxGeometry height="165" width="570" x="625" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="nLim" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Limits &amp;amp; rules&lt;/b&gt;&lt;br&gt;• production accepts persisted queries only&lt;br&gt;• max depth 10 · max cost 5,000 · timeout 5 s&lt;br&gt;• introspection off in production&lt;br&gt;• Relay connections, first ≤ 100&lt;br&gt;• mutations return payload { data, errors[] }&lt;br&gt;• subscriptions via WebSocket (Web PubSub)&lt;br&gt;• tenant from JWT; @key never includes tenantId" vertex="1">
          <mxGeometry height="165" width="570" x="1210" y="1170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
