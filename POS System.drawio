        <mxCell id="tenant_TenantID_t" parent="1" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontColor=#777777;fontSize=10;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="CHAR(26) pk" vertex="1">
          <mxGeometry height="22" width="92" x="140" y="1169" as="geometry" />
        </mxCell>
        <mxCell id="tenantT" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C94545;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="every red TenantID row points here: a logical link to the catalog DB, no FK across databases" vertex="1">
          <mxGeometry height="60" width="300" x="40" y="1205" as="geometry" />
        </mxCell>
        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;pay_components.Type: EARNING, DEDUCTION, EMPLOYER_CONTRIBUTION, REIMBURSEMENT&lt;br&gt;pay_components.CalcMethod: FIXED, PERCENT_OF, FORMULA, ATTENDANCE_BASED&lt;br&gt;payroll_calendars.Frequency: MONTHLY, SEMI_MONTHLY, BIWEEKLY, WEEKLY&lt;br&gt;payroll_periods.Status: OPEN, LOCKED, CLOSED&lt;br&gt;payroll_runs.Type: REGULAR, OFF_CYCLE, FINAL_SETTLEMENT, BONUS&lt;br&gt;payroll_runs.Status: DRAFT, CALCULATED, REVIEWED, APPROVED, PAID, POSTED, CANCELLED&lt;br&gt;payroll_run_employees.Status: OK, ERROR, EXCLUDED&lt;br&gt;statutory_settings.Scheme / contributions.Scheme: PF, ESI, PT, TDS, LWF, OTHER&lt;br&gt;loans_advances.Type: LOAN, SALARY_ADVANCE · Status: ACTIVE, CLOSED&lt;br&gt;reimbursements.Status: SUBMITTED, APPROVED, PAID, REJECTED&lt;br&gt;bank_payout_batches.Channel: SFTP, BANK_API · Status: CREATED, SENT, CONFIRMED, PARTIAL&lt;br&gt;bank_payout_lines.Status: PENDING, PAID, FAILED" vertex="1">
          <mxGeometry height="250" width="640" x="40" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• TenantID (red row) leads every PK and index; FKs are composite.&lt;br&gt;• employees and payroll_runs “(ref)” boxes are copies to keep lines short; employees come from&lt;br&gt;&amp;nbsp;&amp;nbsp;the Employee service by events.&lt;br&gt;• payslip_lines is PARTITION BY RANGE (PayMonth), one partition per month.&lt;br&gt;• Salaries are effective-dated: the row whose EffectiveFrom ≤ period end wins.&lt;br&gt;• Bank account numbers are encrypted with a Key Vault key; screens show the last 4 digits only.&lt;br&gt;• JournalEntryID points to the Accounting service: no FK across services.&lt;br&gt;• Statutory rules live in RuleJson per country / state, read by the statutory plugin." vertex="1">
          <mxGeometry height="220" width="640" x="720" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy · red row = TenantID · ▦ = monthly partitions" vertex="1">
          <mxGeometry height="24" width="1200" x="720" y="1555" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
