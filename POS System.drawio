        <mxCell id="s20" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Audit, Device Mgmt, Tenant" vertex="1">
          <mxGeometry height="34" width="200" x="670" y="710" as="geometry" />
        </mxCell>
        <mxCell id="cCore" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C94545;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;CORE: build in-house, best people&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;Checkout &amp; Sales · Omnichannel Orders · Pricing &amp; Promotions · Inventory &amp; Availability&lt;br&gt;rich domain model, aggregates + invariants, event storming with the business,&lt;br&gt;highest test coverage, own release cadence&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="570" x="960" y="120" as="geometry" />
        </mxCell>
        <mxCell id="cSup" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1E9FB;strokeColor=#3B6FD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;SUPPORTING: build, keep the model simple&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;Payments orchestration · Marketplace · Sync · Purchasing · Customer &amp; Loyalty&lt;br&gt;Payroll · Attendance &amp; Leave · Employee · Store &amp; Organisation&lt;br&gt;anticorruption layers in front of external systems; transaction-script where enough&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="570" x="960" y="290" as="geometry" />
        </mxCell>
        <mxCell id="cGen" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;GENERIC: buy / platform service, thin adapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;Identity (Entra External ID) · Notification (ACS) · Search (Elastic Cloud)&lt;br&gt;Media (Blob + CDN) · Reporting (Fabric / Power BI) · Accounting (GL, later ERP)&lt;br&gt;Audit · Device Management (IoT Hub) · Tenant &amp; Subscription&lt;br&gt;conform to the vendor model; no custom domain logic&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="570" x="960" y="460" as="geometry" />
        </mxCell>
        <mxCell id="cNote" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.4;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;How to read the chart&lt;/b&gt;&lt;br&gt;• up = how much it sets the business apart&lt;br&gt;• right = how complex the model is&lt;br&gt;• subdomains drift over time (e.g. Payroll could move to generic if a payroll SaaS is adopted)&lt;br&gt;• bounded contexts map 1:1 to the microservices in design-decisions §5.3" vertex="1">
          <mxGeometry height="120" width="570" x="960" y="640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
