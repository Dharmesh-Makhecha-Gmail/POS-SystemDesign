        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;spacingLeft=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;payments.Method: CASH, CREDIT, DEBIT, UPI, POINTS&lt;br&gt;payments.Status: PENDING, APPROVED, DECLINED, VOIDED, REFUNDED&lt;br&gt;sales.Status: OPEN, PAID, CANCELLED, VOIDED&lt;br&gt;loyalty_ledger.Type: EARN, REDEEM, HOLD, RELEASE, ADJUST&lt;br&gt;outbox.Channel: SMS, EMAIL · outbox.Status: PENDING, SENT, FAILED&lt;br&gt;stock_movements.Reason: SALE, RETURN, RESTOCK, ADJUST&lt;br&gt;customers.ContactPref: SMS, EMAIL, BOTH, NONE · users.Role: CASHIER, MANAGER, ADMIN" vertex="1">
