          <mxGeometry height="130" width="330" x="1375" y="150" as="geometry" />
        </mxCell>
        <mxCell id="nOff" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Off-cycle runs&lt;/b&gt;&lt;br&gt;Final settlement, bonus and arrears use the same orchestration with a filtered employee list and Type = OFF_CYCLE / FINAL_SETTLEMENT / BONUS (leave encashment, gratuity, notice recovery)." vertex="1">
