        </mxCell>
        <mxCell id="dSh_s2_c0" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#2E9E3E;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=9;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="Blob + CDN" vertex="1">
          <mxGeometry height="28" width="96" x="1312" y="618" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• no shared database: a service never reads another service&#39;s tables&lt;br&gt;• need other data? call it over gRPC, or keep a local copy updated by events&lt;br&gt;• read models (search, reporting, cache) are built from CDC / change feed&lt;br&gt;• MySQL: TenantID leads every key; big services sharded + monthly partitions&lt;br&gt;• Cosmos: hierarchical partition key tenantId / storeId / period&lt;br&gt;• each service has its own migrations (Flyway / EF), run per shard and per stamp" vertex="1">
          <mxGeometry height="342" width="370" x="1630" y="110" as="geometry" />
        </mxCell>
        <mxCell id="nSub" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;On-premise substitutions&lt;/b&gt; (same code, swapped adapters)&lt;br&gt;Cosmos DB → MongoDB-compatible store or PostgreSQL JSONB&lt;br&gt;Service Bus → RabbitMQ · Event Hubs → Kafka&lt;br&gt;Blob → MinIO (S3) · Key Vault → HashiCorp Vault&lt;br&gt;Elasticsearch → self-managed / OpenSearch&lt;br&gt;IoT Hub → MQTT broker · Entra → customer AD / Keycloak&lt;br&gt;Fabric → on-prem warehouse + Power BI Report Server" vertex="1">
          <mxGeometry height="246" width="370" x="1630" y="470" as="geometry" />
        </mxCell>
        <mxCell id="gCdc" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F4FD;strokeColor=#7A6BD6;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="210" width="1570" x="30" y="740" as="geometry" />
