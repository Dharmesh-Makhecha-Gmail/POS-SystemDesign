        <mxCell id="lgKey" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Key&lt;/b&gt; · PKCE = proof key for code exchange (no client secret in apps) · mTLS = both sides present certificates · HMAC = provider signs the body with a shared secret · Sunset = date after which a version returns 410 Gone" vertex="1">
          <mxGeometry height="34" width="1640" x="40" y="1086" as="geometry" />
        </mxCell>
      </root>
