        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values &amp;amp; lookup rules&lt;/b&gt;&lt;br&gt;terminals.DeviceType: DESKTOP, WEB, MOBILE&lt;br&gt;&lt;br&gt;&lt;b&gt;Tax:&lt;/b&gt; tax_rates.StateID null = country-wide rate; the rate&lt;br&gt;used is the one valid on the sale date (ValidFrom/To).&lt;br&gt;&lt;br&gt;&lt;b&gt;Price:&lt;/b&gt; store price list → country (regional) list →&lt;br&gt;tenant default (StoreID and CountryID both null),&lt;br&gt;then by Priority and the valid date range." vertex="1">
          <mxGeometry height="210" width="370" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Multi-tenant rules (every shard table)&lt;/b&gt;&lt;br&gt;• TenantID (red row) leads every PK, unique key and index; FKs are composite,&lt;br&gt;&amp;nbsp;&amp;nbsp;e.g. (TenantID, StoreID). A tenant lives on exactly one shard.&lt;br&gt;• TenantID points to tenants in the catalog DB: a logical link (red dashed),&lt;br&gt;&amp;nbsp;&amp;nbsp;no FK across databases.&lt;br&gt;• Cross-tenant queries are forbidden: EF Core global filter on TenantID.&lt;br&gt;• Masters also carry UpdatedAt, RowVersion, IsDeleted (not drawn).&lt;br&gt;• Elasticsearch (items, customers) and Fabric are fed by CDC from this shard.&lt;br&gt;• item_images: CDN URL /{tenantId}/items/{itemId}/{size}.v{n}.webp;&lt;br&gt;&amp;nbsp;&amp;nbsp;Version bumps on every replace, so cached copies never go stale." vertex="1">
          <mxGeometry height="200" width="700" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · red row = TenantID · red dashed = logical link to catalog DB" vertex="1">
          <mxGeometry height="24" width="1000" x="40" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
