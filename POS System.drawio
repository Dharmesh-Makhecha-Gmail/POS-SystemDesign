  <diagram id="HQIcpqS7H7Vcm4qWUAli" name="DDD Ubiquitous">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#1A1A1A;fontSize=30;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="DDD · Ubiquitous Language" vertex="1">
          <mxGeometry height="44" width="1560" y="14" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#555555;fontSize=13;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="A. the same word means different things in different contexts · B. each context&#39;s own terms and the domain events it publishes" vertex="1">
          <mxGeometry height="24" width="1560" y="58" as="geometry" />
        </mxCell>
        <mxCell id="hA" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="A. Same word, different meaning: always say which context you mean" vertex="1">
          <mxGeometry height="20" width="1000" x="30" y="96" as="geometry" />
        </mxCell>
        <mxCell id="t0" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Customer”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Sales:&lt;/b&gt; buyer at the till; may be a walk-in (no id)&lt;br&gt;&lt;b&gt;Loyalty:&lt;/b&gt; member with tier and points balance&lt;br&gt;&lt;b&gt;Marketplace:&lt;/b&gt; aggregator&#39;s consumer: external id only, no PII&lt;br&gt;&lt;b&gt;Payments:&lt;/b&gt; payer / owner of a saved gateway token&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="30" y="124" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Order”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Orders:&lt;/b&gt; online order with items and a fulfilment&lt;br&gt;&lt;b&gt;Purchasing:&lt;/b&gt; purchase order (PO) sent to a vendor&lt;br&gt;&lt;b&gt;Marketplace:&lt;/b&gt; raw external order event from DoorDash / Uber Eats&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="535" y="124" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Item”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Catalog:&lt;/b&gt; sellable product definition (SKU, barcodes, tax)&lt;br&gt;&lt;b&gt;Inventory:&lt;/b&gt; stock-keeping item per store (on hand)&lt;br&gt;&lt;b&gt;Sales / Orders:&lt;/b&gt; a line on a sale or order (qty × price)&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="1040" y="124" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Store”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Organisation:&lt;/b&gt; physical location with terminals&lt;br&gt;&lt;b&gt;Marketplace:&lt;/b&gt; listing on an aggregator (ExternalStoreId)&lt;br&gt;&lt;b&gt;Storefront:&lt;/b&gt; the store&#39;s web shop (storeSlug)&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="30" y="240" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Return”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Sales:&lt;/b&gt; customer brings goods back → refund&lt;br&gt;&lt;b&gt;Purchasing:&lt;/b&gt; return to vendor (RTV) → debit note&lt;br&gt;&lt;b&gt;Inventory:&lt;/b&gt; stock movement reason RETURN&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="535" y="240" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE9FB;strokeColor=#7A6BD6;strokeWidth=1.6;fontColor=#1A1A1A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;“Shift”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Attendance:&lt;/b&gt; work shift on a roster (time window)&lt;br&gt;&lt;b&gt;Cash:&lt;/b&gt; till session: cashier, float, count, Z report&lt;/span&gt;" vertex="1">
          <mxGeometry height="104" width="490" x="1040" y="240" as="geometry" />
        </mxCell>
        <mxCell id="hB" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1A1A1A;fontSize=13;fontStyle=1;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="B. Glossary and published domain events per bounded context" vertex="1">
          <mxGeometry height="20" width="1000" x="30" y="362" as="geometry" />
        </mxCell>
