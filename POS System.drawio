        <mxCell id="nEnum" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;ENUM values&lt;/b&gt;&lt;br&gt;purchase_orders.Status: DRAFT, SENT, PARTIAL, RECEIVED, CLOSED, CANCELLED&lt;br&gt;vendor_bills.Status: OPEN, MATCHED, DISPUTED, PAID&lt;br&gt;vendor_payments.Method: BANK_TRANSFER, CHEQUE, CASH, UPI&lt;br&gt;accounts.Type: ASSET, LIABILITY, EQUITY, INCOME, EXPENSE&lt;br&gt;journal_entries.SourceType: SALE, GRN, BILL, PAYMENT, ADJUST&lt;br&gt;sync_sessions.Status: RUNNING, OK, PARTIAL, FAILED&lt;br&gt;sync_inbox.Status: APPLIED, DUPLICATE, REJECTED" vertex="1">
          <mxGeometry height="150" width="560" x="40" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="nRules" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E6;strokeColor=#D9A13B;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;• 3-way match: a bill is paid only when PO, GRN and bill quantities and costs agree.&lt;br&gt;• GRNs are made in the store app (ULID id) and pushed like sales; POs, bills and&lt;br&gt;&amp;nbsp;&amp;nbsp;payments are made in the back office.&lt;br&gt;• Journal entries are generated from sales, GRNs, bills and payments (SourceType +&lt;br&gt;&amp;nbsp;&amp;nbsp;SourceID); each entry must balance: total Debit = total Credit.&lt;br&gt;• sync_inbox.ClientRecordID is unique, so a re-sent push becomes DUPLICATE, never a&lt;br&gt;&amp;nbsp;&amp;nbsp;second sale. Rejected records go to sync_conflicts for a back-office user to fix." vertex="1">
          <mxGeometry height="150" width="720" x="640" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#777777;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" value="crow&#39;s foot = many · double bar = exactly one · circle + bar = zero or one · grey dashed = reference copy of a table from ERD 1" vertex="1">
          <mxGeometry height="24" width="900" x="40" y="1430" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
